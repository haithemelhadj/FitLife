  "triggers": [
    "CREATE TRIGGER trg_capacite_seance BEFORE INSERT ON public.reservation_seance FOR EACH ROW EXECUTE FUNCTION check_capacite_seance()",
    "CREATE TRIGGER trg_liberer_place AFTER UPDATE OF statut ON public.reservation_seance FOR EACH ROW EXECUTE FUNCTION liberer_place_seance()",
    "CREATE TRIGGER trg_bloquer_modif BEFORE UPDATE ON public.reservation_seance FOR EACH ROW EXECUTE FUNCTION bloquer_modif_reservation()"
  ],
  "functions": [
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "handle_new_user",
      "definition": "CREATE OR REPLACE FUNCTION public.handle_new_user()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  insert into public.profiles (id, nom, prenom, role)\r\n  values (new.id, new.raw_user_meta_data->>'nom', new.raw_user_meta_data->>'prenom', 'ATHLETE');\r\n  return new;\r\nend; $function$\n"
    },
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "check_capacite_seance",
      "definition": "CREATE OR REPLACE FUNCTION public.check_capacite_seance()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\ndeclare cap int; st statut_seance; nb int;\r\nbegin\r\n  select capacite, statut into cap, st\r\n  from seance where id_seance = new.id_seance for update;\r\n\r\n  if st is null or st <> 'PLANIFIEE' then\r\n    raise exception 'Séance non disponible';\r\n  end if;\r\n\r\n  select count(*) into nb from reservation_seance\r\n  where id_seance = new.id_seance and statut = 'CONFIRMEE';\r\n\r\n  if cap is not null and nb >= cap then\r\n    raise exception 'Séance complète';\r\n  end if;\r\n\r\n  if cap is not null and nb + 1 >= cap then\r\n    update seance set statut = 'COMPLETE' where id_seance = new.id_seance;\r\n  end if;\r\n\r\n  return new;\r\nend $function$\n"
    },
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "liberer_place_seance",
      "definition": "CREATE OR REPLACE FUNCTION public.liberer_place_seance()\n RETURNS trigger\n LANGUAGE plpgsql\n SECURITY DEFINER\n SET search_path TO 'public'\nAS $function$\r\nbegin\r\n  if old.statut = 'CONFIRMEE' and new.statut = 'ANNULEE' then\r\n    update seance set statut = 'PLANIFIEE'\r\n    where id_seance = new.id_seance and statut = 'COMPLETE';\r\n  end if;\r\n  return new;\r\nend $function$\n"
    },
    {
      "acl": [
        "=X/postgres",
        "postgres=X/postgres",
        "anon=X/postgres",
        "authenticated=X/postgres",
        "service_role=X/postgres"
      ],
      "name": "bloquer_modif_reservation",
      "definition": "CREATE OR REPLACE FUNCTION public.bloquer_modif_reservation()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$\r\nbegin\r\n  if new.id_seance <> old.id_seance\r\n     or new.id_athlete <> old.id_athlete\r\n     or new.date_reservation <> old.date_reservation then\r\n    raise exception 'Seule l''annulation est autorisée';\r\n  end if;\r\n  return new;\r\nend $function$\n"
